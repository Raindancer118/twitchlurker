# ── Login ─────────────────────────────────────────────────────────────────────
# "password": one account, no identity provider needed (simplest).
# "oidc": any OpenID Connect provider (Authentik, Keycloak, Authelia, Zitadel, Google, ...).
LURKER_AUTH_MODE=password
LURKER_USERNAME=admin
# At least 12 characters.
LURKER_PASSWORD=

# Only for LURKER_AUTH_MODE=oidc. Redirect URI to register at your provider:
#   https://<your-domain>/login/oauth2/code/oidc
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: explicit endpoints instead of discovery via OIDC_ISSUER_URI
OIDC_AUTHORIZATION_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
OIDC_JWKS_URI=
# Who may log in (comma separated). Empty lists deny everyone.
LURKER_ALLOWED_EMAILS=
LURKER_ALLOWED_GROUPS=
# Claim that carries group names (default: groups)
OIDC_GROUPS_CLAIM=groups

# ── Network ───────────────────────────────────────────────────────────────────
# Host port and bind address. Keep 127.0.0.1 behind a local reverse proxy.
LURKER_PORT=8080
LURKER_BIND=127.0.0.1
# Regex of reverse proxies whose X-Forwarded-* headers are trusted.
# Default covers loopback and private networks; add your proxy's IP if it connects over the internet.
# TRUSTED_PROXIES=
# Set to false only for plain-HTTP testing without a reverse proxy.
COOKIE_SECURE=true

# ── Misc ──────────────────────────────────────────────────────────────────────
LURKER_TIMEZONE=Europe/Berlin
# Pin an image version instead of latest, e.g. 0.7.0
# LURKER_VERSION=latest
# Public drop catalogue source (Twitch hides the list from bot clients)
# LURKER_COMMUNITY_DROPS_URL=https://twitch-drops-api.sunkwi.com/drops
